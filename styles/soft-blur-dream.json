{
  "id": "soft-blur-dream",
  "family": "photo",
  "title": "Soft blur",
  "canvas": [
    1600,
    900
  ],
  "background": "#111",
  "photo": {
    "offset_jitter": [
      20,
      20
    ]
  },
  "filters": [
    {
      "name": "gaussian_blur",
      "param": {
        "radius": {
          "range": [
            1,
            3
          ]
        }
      }
    }
  ],
  "copy": {
    "head": [
      "REMEMBERED WRONG"
    ]
  },
  "texts": [
    {
      "text": "{head}",
      "x": 48,
      "y": "H-80",
      "size": 28,
      "color": "#ffffff"
    }
  ]
}
