{
  "id": "infographic-stat",
  "family": "viral",
  "title": "Big number stat",
  "canvas": [
    1080,
    1350
  ],
  "background": "#0b1220",
  "photo": {
    "opacity": 0.4,
    "offset_jitter": [
      20,
      20
    ]
  },
  "copy": {
    "num": [
      "17",
      "125",
      "3.7B",
      "99%"
    ],
    "label": [
      "HOURS OUT",
      "MISSION",
      "MILES",
      "SURE"
    ]
  },
  "texts": [
    {
      "text": "{num}",
      "x": 48,
      "y": "int(H*0.28)",
      "size": 140,
      "color": "#f4d27a"
    },
    {
      "text": "{label}",
      "x": 56,
      "y": "int(H*0.55)",
      "size": 36,
      "color": "#f6f1e8"
    }
  ]
}
