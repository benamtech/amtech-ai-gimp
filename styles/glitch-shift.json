{
  "id": "glitch-shift",
  "family": "photo",
  "title": "Channel-shift feel (offset)",
  "canvas": [
    1600,
    900
  ],
  "background": "#000",
  "photo": {
    "offset_x": {
      "range": [
        -30,
        30
      ]
    },
    "offset_y": {
      "range": [
        -10,
        10
      ]
    },
    "offset_jitter": [
      0,
      0
    ]
  },
  "filters": [
    {
      "name": "contrast",
      "param": {
        "factor": 1.3
      }
    }
  ],
  "copy": {
    "head": [
      "SYNC ERROR"
    ]
  },
  "texts": [
    {
      "text": "{head}",
      "x": 40,
      "y": 40,
      "size": 36,
      "color": "#00ffff"
    }
  ]
}
