{
  "id": "fuji-ragebait",
  "family": "viral",
  "title": "1:1 viral still — warhol + brand lift + sticker + stacked Impact headlines",
  "canvas": [1080, 1080],
  "background": "#000000",
  "font": "Impact",
  "brand": "retardglobal",
  "photo": {},
  "filters": [
    {"name": "warhol", "param": {"bits": 3}},
    {"name": "color_lift", "param": {"color": "#DEFF2E", "start": 0.42, "strength": 0.38}},
    {"name": "grain", "param": {"n": 6500, "seed": {"range": [0, 99999]}, "alpha": 28, "max_v": 22}}
  ],
  "pillow": {
    "circle_inset": {"d": 0.28, "cx": 0.80, "cy": 0.20, "ring": 13, "ring_color": "#FD2EFF"}
  },
  "copy": {
    "pill": ["BREAKING", "NEWS", "ALERT", "LIVE"],
    "l1": ["FUJIMOTO"],
    "l2": ["DRINKS THE LAST"],
    "l3": ["GRIMACE SHAKE"],
    "l4": ["IN ASIA"],
    "l5": [""],
    "l6": [""]
  },
  "rects": [
    {"x1": 0, "y1": 0, "x2": "int(W*0.065)", "y2": "H", "fill": "#DEFF2E"},
    {"x1": 0, "y1": 0, "x2": "W", "y2": 56, "fill": "#000000"},
    {"x1": 0, "y1": 56, "x2": "W", "y2": 62, "fill": "#DEFF2E"},
    {"x1": 70, "y1": 410, "x2": 340, "y2": 478, "fill": "#FD2EFF"},
    {"x1": "int(W*0.5)-170", "y1": "H-52", "x2": "int(W*0.5)+170", "y2": "H-12", "fill": "#2FF3FF"}
  ],
  "texts": [
    {"text": "{brand_name}", "x": 16, "y": 28, "size": 28, "color": "#DEFF2E", "anchor": "lm", "stroke": 0},
    {"text": "{brand_url}", "x": "int(W-16)", "y": 28, "size": 18, "color": "#2FF3FF", "anchor": "rm", "stroke": 0},
    {"text": "{pill}", "x": 205, "y": 444, "size": 34, "color": "#000000", "anchor": "mm", "stroke": 0},
    {
      "type": "stack",
      "cx": "int(W*0.5+8)",
      "y0": 500,
      "max_w": "int(W-170)",
      "bottom": "int(H-90)",
      "stroke": 7,
      "lines": [
        {"text": "{l1}", "color": "#DEFF2E", "size": 108},
        {"text": "{l2}", "color": "#ffffff", "size": 56},
        {"text": "{l3}", "color": "#FD2EFF", "size": 78},
        {"text": "{l4}", "color": "#2FF3FF", "size": 92},
        {"text": "{l5}", "color": "#ffffff", "size": 48},
        {"text": "{l6}", "color": "#DEFF2E", "size": 44}
      ]
    },
    {"text": "{brand_lock}", "x": "int(W*0.5)", "y": "H-32", "size": 20, "color": "#000000", "anchor": "mm", "stroke": 0}
  ]
}
