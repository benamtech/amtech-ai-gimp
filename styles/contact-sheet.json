{
  "id": "contact-sheet",
  "family": "photo",
  "title": "Contact sheet",
  "canvas": [
    1600,
    1200
  ],
  "background": "#111",
  "photo": {
    "offset_jitter": [
      200,
      200
    ]
  },
  "filters": [
    {
      "name": "grayscale"
    }
  ],
  "copy": {
    "frame": [
      "12A",
      "23",
      "36"
    ]
  },
  "texts": [
    {
      "text": "{frame}",
      "x": 24,
      "y": "H-48",
      "size": 18,
      "color": "#f4d27a"
    }
  ]
}
